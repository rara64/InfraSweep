<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:InfraSweep.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:ic="using:FluentIcons.Avalonia"
		xmlns:converters="using:InfraSweep.App.Converters"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        xmlns:views="using:InfraSweep.App.Views"
        xmlns:models="using:InfraSweep.App.Models"
        x:Class="InfraSweep.App.Views.HostItemView"
        x:DataType="models:HostScanResult"
        x:Name="HostItemViewRoot">

	<UserControl.Resources>
		<converters:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
		<converters:IssueCountToBrushConverter x:Key="IssueCountToBrushConverter" />
		<converters:SeverityToBrushConverter x:Key="SeverityToBrushConverter" />
	</UserControl.Resources>

	<Border Margin="0,8,8,0" Padding="0" CornerRadius="6" Classes.highlighted="{Binding HasNewCves}"
		BorderThickness="1"
	 	Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
		<Border.Styles>
			<Style Selector="Border.highlighted">
				<Setter Property="BorderBrush" Value="#FFA726"/>
			</Style>
		</Border.Styles>
		<Expander HorizontalAlignment="Stretch" IsExpanded="False">
			<Expander.Header>
				<Grid ColumnDefinitions="*,Auto" Margin="8,6">
					<StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
						<StackPanel Orientation="Horizontal" Spacing="8">
							<ic:FluentIcon Icon="Desktop" VerticalAlignment="Center"/>
							
							<Label Content="{Binding Host.FriendlyName}" IsVisible="{Binding Host.FriendlyName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" 
								FontWeight="Bold" FontSize="14" VerticalAlignment="Center" Margin="0"/>
						
							<Border CornerRadius="10" Padding="2" IsVisible="{Binding IsNewHost}" Background="#FFA726">
								<TextBlock Text="{DynamicResource IsNewHostLabel}" FontWeight="Bold" Margin="4,4" FontSize="11" Foreground="Black" />
							</Border>

							<Border CornerRadius="10" Padding="2" IsVisible="{Binding HasNewCves}" Background="#FFA726">
								<TextBlock Text="{DynamicResource HasNewCvesLabel}" FontWeight="Bold" Margin="4,4" FontSize="11" Foreground="Black" />
							</Border>
						</StackPanel>
						<Label Content="{Binding Host.Address}" FontSize="11" Foreground="Gray" />
					</StackPanel>
					<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
						<Label VerticalAlignment="Center" FontSize="12">
							<Label.Content>
								<MultiBinding StringFormat="{}{0} {1}">
									<Binding Path="FoundSoftware.Count"/>
									<Binding Source="{StaticResource ScanResultsServicesRunning}" />
								</MultiBinding>
							</Label.Content>
						</Label>
						<Border CornerRadius="10" Padding="8,2" VerticalAlignment="Center"
                            Background="{Binding TotalCveCount, Converter={StaticResource IssueCountToBrushConverter}}">
							<Label Content="{Binding TotalCveCount}" Foreground="White" FontWeight="Bold" FontSize="12" Margin="0"/>
						</Border>
						
					</StackPanel>
				</Grid>
			</Expander.Header>

			<StackPanel Margin="8,4,8,12" Spacing="8">
				<TextBlock FontSize="18" Text="{DynamicResource DeviceRelatedIssues}" IsVisible="{Binding HostVulnerabilities.Cves, Converter={StaticResource CountToVisibilityConverter}, FallbackValue=False}" />
				<ItemsControl ItemsSource="{Binding HostVulnerabilities.Cves}">
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<views:CveItemView />
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>

				<Border IsVisible="{Binding FoundSoftware, Converter={StaticResource CountToVisibilityConverter}}">
					<StackPanel>
						<TextBlock FontSize="18" Text="{DynamicResource ServiceRelatedIssues}" Margin="0,8" />
						<ItemsControl ItemsSource="{Binding FoundSoftware}">
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<Expander Margin="0,2" Background="{DynamicResource SystemControlBackgroundAltLowBrush}" HorizontalAlignment="Stretch" IsEnabled="{Binding Vulnerabilities.Cves, Converter={StaticResource CountToVisibilityConverter}, FallbackValue=False}">
										<Expander.Header>
											<Grid ColumnDefinitions="*,Auto" Margin="0,2">
												<StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="1">
													<StackPanel Orientation="Horizontal" Spacing="8">
														<ic:FluentIcon Icon="PlugConnected" />
														<TextBlock Text="{Binding Software.Name}" FontWeight="SemiBold" FontSize="13" Margin="0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
														<Label Content="{Binding Software.Version}" VerticalAlignment="Center" FontSize="12" Foreground="Gray"/>
													</StackPanel>
													<Label FontSize="10" Foreground="Gray">
														<Label.Content>
															<MultiBinding StringFormat="{}{0} {1}">
																<Binding Source="{StaticResource ScanResultsOnPort}" />
																<Binding Path="Port"/>
															</MultiBinding>
														</Label.Content>
													</Label>
												</StackPanel>

												<Border Grid.Column="1" CornerRadius="10" Padding="8,2" VerticalAlignment="Center" Margin="8,0,0,0"
                                                    Background="{Binding Vulnerabilities.Cves.Count, Converter={StaticResource IssueCountToBrushConverter}}">
													<Label Content="{Binding Vulnerabilities.Cves.Count}" Foreground="White" FontWeight="Bold" FontSize="12" Margin="0"/>
												</Border>
											</Grid>
										</Expander.Header>
										<StackPanel>
											<TextBlock IsVisible="{Binding Vulnerabilities.NextPageExists}">
												<TextBlock.Text>
													<MultiBinding StringFormat="{}{0} {1} {2}">
														<Binding Source="{StaticResource CveListTruncatedTo}" />
														<Binding Path="Vulnerabilities.Cves.Count"/>
														<Binding Source="{StaticResource CveListEntriesWord}" />
													</MultiBinding>			
												</TextBlock.Text>
											</TextBlock>
											<ItemsControl ItemsSource="{Binding Vulnerabilities.Cves}" Margin="16,4,0,0">
												<ItemsControl.ItemTemplate>
													<DataTemplate>
														<views:CveItemView />
													</DataTemplate>
												</ItemsControl.ItemTemplate>
											</ItemsControl>
										</StackPanel>
									</Expander>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</StackPanel>
				</Border>
			</StackPanel>
		</Expander>
	</Border>
</UserControl>