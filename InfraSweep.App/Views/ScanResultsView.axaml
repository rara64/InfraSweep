<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:InfraSweep.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:ic="using:FluentIcons.Avalonia"
		xmlns:converters="using:InfraSweep.App.Converters"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="InfraSweep.App.Views.ScanResultsView"
        x:DataType="vm:ScanResultsViewModel">

	<UserControl.Resources>
		<converters:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
		<converters:IssueCountToBrushConverter x:Key="IssueCountToBrushConverter" />
		<converters:SeverityToBrushConverter x:Key="SeverityToBrushConverter" />
	</UserControl.Resources>

	<Grid Margin="8">
		<StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsVisible="{Binding !HasResults}">
			<Label Content="{Binding Locale[NoScanData]}" FontSize="16"/>
			<TextBlock Text="Start a scan to view discovered hosts, services, and security issues." FontSize="12" Opacity="0.8" TextAlignment="Center" Margin="0,8,0,0"/>
		</StackPanel>
		<ScrollViewer IsVisible="{Binding HasResults}" Margin="0,8,0,0">
			<Grid RowDefinitions="Auto,Auto,*" VerticalAlignment="Top">
				<TextBlock Text="Scan summary" FontSize="18" FontWeight="Bold" Grid.Row="0" Margin="0,0,0,8"/>
				<Grid Grid.Row="1" HorizontalAlignment="Stretch" Margin="0,0,8,0" ColumnDefinitions="*,*,*,*">
					<Border CornerRadius="4" HorizontalAlignment="Stretch" Height="120" Margin="0,0,8,0" Background="{DynamicResource SystemControlBackgroundAltLowBrush}" BorderBrush="{DynamicResource SystemAccentColorDark1}" BorderThickness="2" Grid.Column="0">
						<StackPanel VerticalAlignment="Center">
							<ic:FluentIcon Icon="Desktop" />
							<Label Content="{Binding Locale[ScanResultsHostCountLabel]}" HorizontalAlignment="Center" FontWeight="Bold" FontSize="12"/>
							<Label Content="{Binding HostCount}" HorizontalAlignment="Center" FontSize="16"/>
						</StackPanel>
					</Border>
					<Border CornerRadius="4" HorizontalAlignment="Stretch" Height="120" Margin="0,0,8,0" Background="{DynamicResource SystemControlBackgroundAltLowBrush}" BorderBrush="{DynamicResource SystemAccentColorDark1}" BorderThickness="2" Grid.Column="1">
						<StackPanel VerticalAlignment="Center">
							<ic:FluentIcon Icon="PlugConnected" />
							<Label Content="{Binding Locale[ScanResultsServiceCountLabel]}" HorizontalAlignment="Center" FontWeight="Bold" FontSize="12"/>
							<Label Content="{Binding ServiceCount}" HorizontalAlignment="Center" FontSize="16"/>
						</StackPanel>
					</Border>
					<Border CornerRadius="4" HorizontalAlignment="Stretch" Height="120" Margin="0,0,8,0" Background="{DynamicResource SystemControlBackgroundAltLowBrush}" BorderBrush="#C62828" BorderThickness="2" Grid.Column="2">
						<StackPanel VerticalAlignment="Center">
							<ic:FluentIcon Icon="Warning" />
							<Label Content="{Binding Locale[ScanResultsVulnerabilityCountLabel]}" HorizontalAlignment="Center" FontWeight="Bold" FontSize="12"/>
							<Label Content="{Binding VulnerabilityCount}" HorizontalAlignment="Center" FontSize="16"/>
						</StackPanel>
					</Border>
					<Border CornerRadius="4" HorizontalAlignment="Stretch" Height="120" Background="{DynamicResource SystemControlBackgroundAltLowBrush}" BorderBrush="#FFA726" BorderThickness="2" Grid.Column="3">
						<StackPanel VerticalAlignment="Center">
							<ic:FluentIcon Icon="Calendar" />
							<Label Content="{Binding Locale[ScanResultsCurrentYearVulnerabilityCountLabel]}" HorizontalAlignment="Center" FontWeight="Bold" FontSize="12"/>
							<Label Content="{Binding CurrentYearVulnerabilityCount}" HorizontalAlignment="Center" FontSize="16"/>
						</StackPanel>
					</Border>
				</Grid>
				<ItemsControl ItemsSource="{Binding LatestResult.Hosts}" Grid.Row="2">
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<Expander HorizontalAlignment="Stretch" IsExpanded="{Binding FoundSoftware, Converter={StaticResource CountToVisibilityConverter}}">
								<Expander.Header>
									<Grid ColumnDefinitions="*,Auto">
										<StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
											<ic:FluentIcon Icon="Desktop" VerticalAlignment="Center"/>
											<Label Content="{Binding Host.Address}" FontWeight="Bold" VerticalAlignment="Center"/>
											<Label Content="{Binding Host.HostCpe}" FontSize="11" Foreground="Gray" VerticalAlignment="Center"
												IsVisible="{Binding Host.HostCpe, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
										</StackPanel>
										<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
											<Label VerticalAlignment="Center" FontSize="12">
												<Label.Content>
													<MultiBinding StringFormat="{}{0} {1}">
														<Binding Path="FoundSoftware.Count"/>
														<Binding Path="((vm:ScanResultsViewModel)DataContext).Locale[ScanResultsServicesRunning]" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
													</MultiBinding>
												</Label.Content>
											</Label>
											<Border CornerRadius="10" Padding="8,2" VerticalAlignment="Center"
												Background="{Binding TotalCveCount, Converter={StaticResource IssueCountToBrushConverter}}">
												<Label Content="{Binding TotalCveCount}" Foreground="White" FontWeight="Bold" FontSize="12" Margin="0"/>
											</Border>
										</StackPanel>
									</Grid>
								</Expander.Header>

								<StackPanel>
									<ItemsControl ItemsSource="{Binding HostVulnerabilities.Cves}">
										<ItemsControl.ItemTemplate>
											<DataTemplate>
												<Border Margin="0,4" Padding="10" CornerRadius="4" Background="{DynamicResource SystemControlBackgroundAltLowBrush}">
													<StackPanel>
														<StackPanel Orientation="Horizontal" Spacing="8">
															<Border CornerRadius="4" Padding="6,2"
																Background="{Binding BaseSeverity, Converter={StaticResource SeverityToBrushConverter}}">
																<Label Content="{Binding BaseSeverity}" Foreground="White" FontWeight="Bold" FontSize="11" Margin="0"/>
															</Border>
															<Label Content="{Binding CveId}" FontWeight="Bold" VerticalAlignment="Center"/>
															<Label Content="{Binding DatePublished, StringFormat='{}{0:MMM d, yyyy}'}" Foreground="Gray" VerticalAlignment="Center"/>
														</StackPanel>
														<TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,6,0,0" Opacity="0.85"/>
													</StackPanel>
												</Border>
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
									<ItemsControl ItemsSource="{Binding FoundSoftware}">
										<ItemsControl.ItemTemplate>
											<DataTemplate>
												<Expander HorizontalAlignment="Stretch" Margin="0,4">
													<Expander.Header>
														<StackPanel>
															<StackPanel Orientation="Horizontal" Spacing="6">
																<Label Content="{Binding Software.Name}" FontWeight="SemiBold"/>
																<Label Content="{Binding Software.Version}" VerticalAlignment="Center"/>
															</StackPanel>
															<Label FontSize="11" Foreground="Gray" Margin="0,-4,0,0">
																<Label.Content>
																	<MultiBinding StringFormat="{}{0} {1}">
																		<Binding Path="((vm:ScanResultsViewModel)DataContext).Locale[ScanResultsOnPort]" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
																		<Binding Path="Port"/>
																	</MultiBinding>
																</Label.Content>
															</Label>
														</StackPanel>
													</Expander.Header>

													<ItemsControl ItemsSource="{Binding Vulnerabilities.Cves}" Margin="16,4,0,4">
														<ItemsControl.ItemTemplate>
															<DataTemplate>
																<Border Margin="0,4" Padding="10" CornerRadius="4" Background="{DynamicResource SystemControlBackgroundAltLowBrush}">
																	<StackPanel>
																		<StackPanel Orientation="Horizontal" Spacing="8">
																			<Border CornerRadius="4" Padding="6,2"
																				Background="{Binding BaseSeverity, Converter={StaticResource SeverityToBrushConverter}}">
																				<Label Content="{Binding BaseSeverity}" Foreground="White" FontWeight="Bold" FontSize="11" Margin="0"/>
																			</Border>
																			<Label Content="{Binding CveId}" FontWeight="Bold" VerticalAlignment="Center"/>
																			<Label Content="{Binding DatePublished, StringFormat='{}{0:MMM d, yyyy}'}" Foreground="Gray" VerticalAlignment="Center"/>
 																		</StackPanel>
																		<TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,6,0,0" Opacity="0.85"/>
																	</StackPanel>
																</Border>
															</DataTemplate>
														</ItemsControl.ItemTemplate>
													</ItemsControl>
												</Expander>
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
								</StackPanel>
							</Expander>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</Grid>
		</ScrollViewer>
	</Grid>
</UserControl>